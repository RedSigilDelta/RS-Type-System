feature mkmk {
  lookup MKMK_TOP {
    pos mark acutecomb <anchor 0 190> mark @MC_TOP;
    pos mark brevecomb <anchor 0 190> mark @MC_TOP;
    pos mark caroncomb <anchor 0 190> mark @MC_TOP;
    pos mark circumflexcomb <anchor 0 190> mark @MC_TOP;
    pos mark dieresiscomb <anchor 0 190> mark @MC_TOP;
    pos mark dotaccentcomb <anchor 0 190> mark @MC_TOP;
    pos mark gravecomb <anchor 0 190> mark @MC_TOP;
    pos mark hungarumlautcomb <anchor 0 190> mark @MC_TOP;
    pos mark macroncomb <anchor 0 190> mark @MC_TOP;
    pos mark ringcomb <anchor 0 190> mark @MC_TOP;
    pos mark tildecomb <anchor 0 190> mark @MC_TOP;
  } MKMK_TOP;
  lookup MKMK_BOTTOM {
    pos mark cedillacomb <anchor 0 -190> mark @MC_BOTTOM;
    pos mark commaaccentcomb <anchor 0 -190> mark @MC_BOTTOM;
  } MKMK_BOTTOM;
} mkmk;

# Family-specific OpenType features retained alongside shared layout features.
@K_A = [A Agrave Aacute Acircumflex Atilde Adieresis Aring Amacron Abreve Aogonek];
@K_V = [V];
@K_W = [W Wcircumflex Wgrave Wacute Wdieresis];
@K_T = [T Tcaron Tcommaaccent];
@K_Y = [Y Yacute Ycircumflex Ydieresis Ygrave];
@K_L = [L Lacute uni013B Lcaron];
@K_F = [F];
@K_P = [P];
@K_R = [R Racute Rcaron];
@K_O = [O Ograve Oacute Ocircumflex Otilde Odieresis Ohungarumlaut];
@K_o = [o ograve oacute ocircumflex otilde odieresis ohungarumlaut];
@K_e = [e egrave eacute ecircumflex edieresis emacron edotaccent eogonek ecaron];
@K_a = [a agrave aacute acircumflex atilde adieresis aring amacron abreve aogonek];
@K_r = [r racute rcaron];
feature kern {
  pos @K_A @K_V -42;
  pos @K_A @K_W -34;
  pos @K_V @K_A -42;
  pos @K_W @K_A -34;
  pos @K_T @K_o -38;
  pos @K_T @K_e -38;
  pos @K_T @K_a -34;
  pos @K_Y @K_o -40;
  pos @K_Y @K_e -38;
  pos @K_Y @K_a -36;
  pos @K_L @K_T -28;
  pos @K_F @K_o -22;
  pos @K_P @K_a -20;
  pos @K_R @K_o -12;
  pos @K_r @K_o -10;
} kern;
