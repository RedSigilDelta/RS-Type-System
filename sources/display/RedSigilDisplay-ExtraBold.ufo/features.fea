feature mkmk {
  lookup MKMK_TOP {
    pos mark acutecomb <anchor 0 190> mark @MC_TOP;
    pos mark brevecomb <anchor 0 190> mark @MC_TOP;
    pos mark caroncomb <anchor 0 190> mark @MC_TOP;
    pos mark circumflexcomb <anchor 0 190> mark @MC_TOP;
    pos mark dieresiscomb <anchor 0 190> mark @MC_TOP;
    pos mark dotaccentcomb <anchor 0 190> mark @MC_TOP;
    pos mark gravecomb <anchor 0 190> mark @MC_TOP;
    pos mark hungarumlautcomb <anchor 0 190> mark @MC_TOP;
    pos mark macroncomb <anchor 0 190> mark @MC_TOP;
    pos mark ringcomb <anchor 0 190> mark @MC_TOP;
    pos mark tildecomb <anchor 0 190> mark @MC_TOP;
  } MKMK_TOP;
  lookup MKMK_BOTTOM {
    pos mark cedillacomb <anchor 0 -190> mark @MC_BOTTOM;
    pos mark commaaccentcomb <anchor 0 -190> mark @MC_BOTTOM;
  } MKMK_BOTTOM;
} mkmk;

# Family-specific OpenType features retained alongside shared layout features.
@KERN_A = [A];
@KERN_VY = [V W Y];
@KERN_T = [T];
@KERN_LOWER_ROUND = [a c e o];
@KERN_LOWER_OPEN = [a e o];
@KERN_QUOTES = [quotesingle quotedbl];

feature kern {
  lookup KERN_CAPS {
    pos @KERN_A @KERN_VY -70;
    pos @KERN_VY @KERN_A -70;
    pos @KERN_A @KERN_T -40;
    pos @KERN_T @KERN_A -55;
    pos F A -45;
    pos P A -45;
    pos L @KERN_T -45;
    pos L @KERN_VY -50;
    pos R @KERN_VY -25;
    pos @KERN_QUOTES A -55;
  } KERN_CAPS;
  lookup KERN_T_LOWER {
    pos @KERN_T @KERN_LOWER_ROUND -65;
    pos T hyphen -35;
  } KERN_T_LOWER;
  lookup KERN_V_LOWER {
    pos V @KERN_LOWER_OPEN -45;
    pos V period -45;
    pos V comma -45;
  } KERN_V_LOWER;
  lookup KERN_W_LOWER {
    pos W @KERN_LOWER_OPEN -35;
    pos W period -35;
    pos W comma -35;
  } KERN_W_LOWER;
  lookup KERN_Y_LOWER {
    pos Y @KERN_LOWER_ROUND -70;
    pos Y period -55;
    pos Y comma -55;
  } KERN_Y_LOWER;
  lookup KERN_F_LOWER {
    pos F @KERN_LOWER_OPEN -35;
  } KERN_F_LOWER;
  lookup KERN_LOWER {
    pos r @KERN_LOWER_OPEN -18;
    pos v @KERN_LOWER_OPEN -22;
    pos w @KERN_LOWER_OPEN -18;
    pos y @KERN_LOWER_OPEN -20;
  } KERN_LOWER;
} kern;
