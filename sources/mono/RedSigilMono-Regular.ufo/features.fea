@GDEF_MARK = [acutecomb brevecomb caroncomb circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb cedillacomb commaaccentcomb ogonekcomb caronrightcomb commahelpercomb commahelpercomb.above];
table GDEF {
  GlyphClassDef @GDEF_BASE, , @GDEF_MARK, ;
} GDEF;

markClass acutecomb <anchor 0 0> @MC_TOP;
markClass brevecomb <anchor 0 0> @MC_TOP;
markClass caroncomb <anchor 0 0> @MC_TOP;
markClass circumflexcomb <anchor 0 0> @MC_TOP;
markClass dieresiscomb <anchor 0 0> @MC_TOP;
markClass dotaccentcomb <anchor 0 0> @MC_TOP;
markClass gravecomb <anchor 0 0> @MC_TOP;
markClass hungarumlautcomb <anchor 0 0> @MC_TOP;
markClass macroncomb <anchor 0 0> @MC_TOP;
markClass ringcomb <anchor 0 0> @MC_TOP;
markClass tildecomb <anchor 0 0> @MC_TOP;
markClass cedillacomb <anchor 0 0> @MC_BOTTOM;
markClass commaaccentcomb <anchor 0 0> @MC_BOTTOM;
markClass ogonekcomb <anchor 0 0> @MC_OGONEK;
markClass caronrightcomb <anchor 0 0> @MC_CARONRIGHT;
markClass commahelpercomb <anchor 0 0> @MC_COMMABELOW;
markClass commahelpercomb.above <anchor 0 0> @MC_COMMAABOVE;

@CCMP_TOP_MARKS = [acutecomb brevecomb caroncomb circumflexcomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];
feature ccmp {
  sub i' @CCMP_TOP_MARKS by dotlessi;
  sub j' @CCMP_TOP_MARKS by dotlessj;
  sub G cedillacomb' by commahelpercomb;
  sub K cedillacomb' by commahelpercomb;
  sub L cedillacomb' by commahelpercomb;
  sub N cedillacomb' by commahelpercomb;
  sub d caroncomb' by caronrightcomb;
  sub g cedillacomb' by commahelpercomb.above;
  sub k cedillacomb' by commahelpercomb;
  sub l caroncomb' by caronrightcomb;
  sub l cedillacomb' by commahelpercomb;
  sub n cedillacomb' by commahelpercomb;
  sub t caroncomb' by caronrightcomb;
} ccmp;

feature locl {
  script latn;
  language CAT;
  sub l periodcentered' l by periodcentered.loclCAT;
  sub L periodcentered' L by periodcentered.loclCAT.case;
} locl;

